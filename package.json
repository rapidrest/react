{
    "name": "@rapidrest/react",
    "version": "2.3.0",
    "description": "A library for serving React based content from a RapidREST server.",
    "repository": "https://github.com/rapidrest/react.git",
    "author": "RapidREST <rapidrests@gmail.com>",
    "license": "MPL-2.0",
    "contributors": [
        "Jean-Philippe Steinmetz"
    ],
    "scripts": {
        "build": "yarn lint && rimraf dist && tsc && tsc -p tsconfig.client.json && tsc -p tsconfig.vite.json && tsc -p tsconfig.cli.json",
        "lint": "eslint ./src ./test",
        "local-audit": "yarn install && yarn npm audit -A -R \"$@\"",
        "checkup": "yarn dlx @yarnpkg/doctor \"$@\"",
        "dependency-check": "yarn dlx depcheck \"$@\"",
        "report-coverage": "cat ./coverage/lcov.info | coveralls",
        "bench": "tsx bench/index.ts",
        "bench:baseline": "yarn bench 2>&1 | tee bench/baseline.txt",
        "test": "vitest run",
        "test:prod": "npm run lint && vitest run --coverage",
        "test:watch": "vitest",
        "release": "rapidrest release"
    },
    "peerDependencies": {
        "@rapidrest/core": "6.x",
        "@rapidrest/service-core": "2.x",
        "@vitejs/plugin-react": ">=4.0.0",
        "nodemon": ">=3.0.0",
        "react": "19.x",
        "react-dom": "19.x",
        "tsx": ">=4.0.0",
        "vite": ">=5.0.0"
    },
    "peerDependenciesMeta": {
        "@vitejs/plugin-react": {
            "optional": true
        },
        "nodemon": {
            "optional": true
        },
        "tsx": {
            "optional": true
        },
        "vite": {
            "optional": true
        }
    },
    "bin": {
        "rapidreact": "./dist/cli/cli.js"
    },
    "dependencies": {
        "cross-spawn": "^7.0.6"
    },
    "devDependencies": {
        "@rapidrest/cli": "^2.1.0",
        "@rapidrest/core": "^6.1.0",
        "@rapidrest/service-core": "^2.6.0",
        "@swc/core": "^1.16.21",
        "@types/cross-spawn": "^6.0.6",
        "@types/node": "^26.6.6",
        "@typescript-eslint/eslint-plugin": "^8.72.1",
        "@typescript-eslint/parser": "^8.72.1",
        "@vitejs/plugin-react": "^6.2.1",
        "@vitest/coverage-v8": "^5.1.0",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jsdoc": "^65.4.3",
        "globals": "^17.14.0",
        "jsdom": "^30.1.3",
        "lodash-es": "^4.18.1",
        "mongodb": "^7.8.0",
        "nconf": "^0.13.0",
        "openapi3-ts": "^4.6.2",
        "prom-client": "^15.1.3",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "redis": "^6.3.1",
        "reflect-metadata": "^0.2.2",
        "rimraf": "^6.1.4",
        "ts-node": "^10.9.2",
        "tsx": "^4.23.15",
        "typeorm": "^1.1.2",
        "typescript": "^6.0.3",
        "unplugin-swc": "^2.0.0",
        "vite": "^8.3.5",
        "vitest": "^5.1.0",
        "winston": "^3.19.0"
    },
    "resolutions": {
        "cross-spawn": "^7.0.6"
    },
    "packageManager": "yarn@4.5.3",
    "engines": {
        "node": ">=24.0.0"
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.org/"
    },
    "type": "module",
    "main": "dist/lib/index.js",
    "exports": {
        ".": {
            "import": "./dist/lib/index.js",
            "types": "./dist/types/index.d.ts"
        },
        "./client": {
            "import": "./dist/client/client.js",
            "types": "./dist/client/client.d.ts"
        },
        "./vite": {
            "import": "./dist/vite/vite.js",
            "types": "./dist/vite/vite.d.ts"
        },
        "./tsconfig/client": "./tsconfig.client.base.json"
    },
    "typings": "dist/types/index.d.ts",
    "files": [
        "dist",
        "docs",
        "tsconfig.client.base.json"
    ]
}
